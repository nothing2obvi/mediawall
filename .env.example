# Bob is the Jellyfin admin. MediaWall needs his admin API key, not user passwords.
JELLYFIN_URL=http://jellyfin.example.local:8096
JELLYFIN_API_KEY=replace-with-bobs-admin-api-key
JELLYFIN_BOB_USER=bob-jellyfin
JELLYFIN_ALICE_USER=alice-jellyfin
JELLYFIN_JACOB_USER=jacob-jellyfin

# Navidrome is this household's Subsonic server.
SUBSONIC_URL=http://navidrome.example.local:4533
SUBSONIC_BOB_USER=bob-navidrome
SUBSONIC_BOB_PASSWORD=replace-with-bobs-navidrome-password
SUBSONIC_ALICE_USER=alice-navidrome
SUBSONIC_ALICE_PASSWORD=replace-with-alices-navidrome-password
SUBSONIC_JACOB_USER=jacob-navidrome
SUBSONIC_JACOB_PASSWORD=replace-with-jacobs-navidrome-password

# Generate three different secrets; copy each to the matching Multi-Scrobbler client.
EXTERNAL_MUSIC_BOB_TOKEN=replace-with-bobs-random-secret
EXTERNAL_MUSIC_ALICE_TOKEN=replace-with-alices-random-secret
EXTERNAL_MUSIC_JACOB_TOKEN=replace-with-jacobs-random-secret

# Optional space passwords. The Kiosk URL must also work in the display browser.
LIVINGROOM_PASSWORD=
HOMELAB_PASSWORD=
LIVINGROOM_IMMICH_KIOSK_URL=https://immich-kiosk.example.com/?password=replace-me

# Optional providers. Disable a keyed provider in config.yml if you don't use it.
FANART_API_KEY=
THEAUDIODB_API_KEY=
MUSICBRAINZ_CONTACT=
LOG_LEVEL=info
